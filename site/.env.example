# Public (build-time, present in bundle) — expand in CF Pages dashboard per environment
TURNSTILE_SITE_KEY=pk_xxx
ANALYTICS_SITE_ID=
PLAUSIBLE_DOMAIN=ixi.example
# Server-only (never expose to client)
TURNSTILE_SECRET_KEY=sk_xxx
RESEND_API_KEY=re_xxx
FORM_WEBHOOK_URL=
FORM_WEBHOOK_SECRET=
LOG_PEPPER=change-me-32-bytes
RESEND_FROM=IXI <hello@ixi.example>
RESEND_TO=inquiries@ixi.example
APP_ENV=production
SITE_URL=https://www.ixi.example
DEV_STUB=0
# Cloudflare rate-limit store (optional; in-memory fallback when absent)
KV_COUNTER=
CF_PAGES_PROJECT=ixi
# Calendly
CALENDLY_URL=https://calendly.com/ixi/15-min