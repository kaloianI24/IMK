# IMK environment variables
# Copy this file to `.env` and replace the placeholder values with real ones.
# `.env` is gitignored and must never be committed. Real values do not exist yet
# — placeholders below show the shape only.
#
# ============================================================================
# OWNER-SUPPLIED VALUES (required for production)
# ============================================================================
# The following must be provided by the owner / deployer:
#   SITE_URL, SITE_BASE_URL, ADMIN_EMAILS, RESEND_API_KEY,
#   RESEND_FROM, RESEND_TO, FORM_WEBHOOK_SECRET,
#   TURNSTILE_SECRET_KEY, PORTAL_MAGIC_LINK_SECRET,
#   PORTAL_SESSION_SECRET, PORTAL_STORE, LIBSQL_URL, LIBSQL_TOKEN
#
# TRUST_CF_CONNECTING_IP is ONLY set to '1' when Cloudflare actually fronts
# Vercel (traffic: Cloudflare → Vercel). Vercel never sets cf-connecting-ip.
# The Cloudflare Pages twin sets this automatically.
# ============================================================================

# --- Site ---
# Canonical URL used for sitemap, canonical tags and Open Graph images.
# Replace https://www.imk.example with your real domain before launch.
SITE_URL=https://www.imk.example

# --- Turnstile (Cloudflare) — spam protection for POST /api/contact ---
# Create a site key at https://dash.cloudflare.com (Turnstile → Add site).
# The secret is server-only; the site key is read by the client (PUBLIC_ prefix).
TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=0x00000000000000000000000000000000000AA

# --- Resend — transactional e-mail (contact form + reviews) ---
RESEND_API_KEY=re_1234567890abcdef0123456789abcdef01
# NOTE: Resend only accepts a From address that is a verified sending identity.
# 2imk4support@gmail.com works only if verified in Resend; for production prefer
# a verified domain sender (e.g. "IMK <hello@yourdomain>").
RESEND_FROM="IMK <2imk4support@gmail.com>"
RESEND_TO=2imk4support@gmail.com
# Contact-form destination inbox; api/contact.ts falls back to this when RESEND_TO is unset.
CONTACT_TO=2imk4support@gmail.com

# --- Moderation — HMAC secret for signed approve/reject links ---
# Used by api/moderate/review.ts and site/shared/server/notifications.ts.
# Generate with: openssl rand -hex 32
FORM_WEBHOOK_SECRET=REPLACE_ME_FORM_WEBHOOK_SECRET_openssl_rand_hex_32

# --- Rate limiting ---
# Cloudflare Pages: KV binding name wired in the Pages project settings (functions/api/contact.ts).
# Vercel (root api/contact.ts): KV is not available, so a per-instance in-memory
# fallback is used instead — this key is read by neither on Vercel.
KV_COUNTER=form-rate-limit
CF_PAGES_PROJECT=imk
# Portal rate counters (spec/08 §4.7.1). Unset = in-memory per instance, which
# resets on every cold start of a serverless target. Set it to a writable file
# on a self-hosted/VPS target to make the counters durable across restarts.
# The keys are hashed, so no client id and no IP address is written to the file.
# PORTAL_RATE_LIMIT_FILE=site/data/portal/rate-limits.json

# --- App ---
# APP_ENV=development is an example value only. The production fail-closed guards
# are active whenever APP_ENV is NOT 'development' OR NODE_ENV=production OR
# VERCEL=1 OR SITE_BASE_URL starts with https://.
# A deployment without real secrets will answer 500 {code:'internal'}.
APP_ENV=development
# DEV_STUB must never be '1' in production (contact.ts refuses to start if it is).
DEV_STUB=

# --- Portal (client/owner auth, spec/08) ---
# Base URL for magic-link links and cookie origin. Defaults to localhost dev;
# swap to your real domain at deploy time (one env-var change).
SITE_BASE_URL=http://localhost:4321
# Comma-separated admin emails (site owner). Magic-link login to these emails
# grants the admin role in /portal AND opens /admin (the owner inbox).
# The list is read on EVERY admin request, so removing an address here revokes
# access immediately - not when the 24h session token expires.
ADMIN_EMAILS=you@imk.example
# HMAC secret for signing magic-link tokens. Generate with: openssl rand -hex 32
# REQUIRED IN PRODUCTION: with no secret the sign-in endpoints answer
# 500 {code:'internal'} for every address (an empty HMAC key is a public key,
# so a missing secret must never fall back to a forgeable token).
PORTAL_MAGIC_LINK_SECRET=REPLACE_ME_PORTAL_MAGIC_LINK_SECRET_openssl_rand_hex_32
# HMAC secret for signing the SESSION token (spec/08 4.9). PORTAL_SESSION_SECRET
# wins; PORTAL_MAGIC_LINK_SECRET above is the fallback, so a deployment can be
# configured with one secret.
# REQUIRED IN PRODUCTION: with no secret no session can be minted and every
# sign-in answers 500 {code:'internal'}. The session is what /admin checks.
PORTAL_SESSION_SECRET=REPLACE_ME_PORTAL_SESSION_SECRET_openssl_rand_hex_32

# --- Storage (T4: libSQL adapter for portal, spec/08 §4.8.5) ---
# Which store backend to use: 'file' (local dev) or 'libsql' (production).
# The libSQL adapter IS built and proven (npm run test:store = 72/72: 27 file, 34 libsql, 11 shared).
# The portal handlers are wired to it (wave 9 landed, wave 13 refactored).
# On Vercel, 'file' cannot persist writes (read-only filesystem).
PORTAL_STORE=file
# Turso/libSQL database URL (for PORTAL_STORE=libsql). Create a free-tier
# database at https://turso.tech and copy the Database URL.
# Example: libsql://imk-portal-<org>.turso.io
LIBSQL_URL=
# Turso auth token for the libSQL database. Generate in the Turso dashboard.
# NEVER commit this token, never log it, never paste it into a report or chat.
LIBSQL_TOKEN=
# Trust cf-connecting-ip header (set to '1' ONLY when Cloudflare fronts Vercel).
# Vercel never sets cf-connecting-ip; it sets x-real-ip and x-vercel-forwarded-for.
# The Cloudflare Pages twin sets this automatically.
TRUST_CF_CONNECTING_IP=

# --- Contact form logging & webhooks ---
# Pepper for IP hashing in contact form logs (dev default: 'dev').
LOG_PEPPER=dev
# Optional webhook URL for contact form submissions (review finding B8).
# When set, a signed payload is POSTed to this URL on each submission.
FORM_WEBHOOK_URL=
