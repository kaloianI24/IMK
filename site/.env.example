# IXI environment variables
# Copy this file to `.env` and replace the placeholder values with real ones.
# `.env` is gitignored and must never be committed. Real values do not exist yet
# — placeholders below show the shape only.

# --- Site ---
# Canonical URL used for sitemap, canonical tags and Open Graph images.
# Replace https://www.ixi.example with your real domain before launch (e.g. https://ixi.agency).
SITE_URL=https://www.ixi.example

# Calendly booking link used by /book.
CALENDLY_URL=https://calendly.com/ixi

# --- Turnstile (Cloudflare) — spam protection for POST /api/contact ---
# Create a site key at https://dash.cloudflare.com (Turnstile → Add site).
# The secret is server-only; the site key is read by the client (PUBLIC_ prefix).
TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=0x00000000000000000000000000000000000AA

# --- Resend — transactional e-mail (contact form + reviews) ---
RESEND_API_KEY=re_1234567890abcdef0123456789abcdef01
RESEND_FROM="IXI <hello@ixi.example>"
RESEND_TO=hello@ixi.example
# Contact-form destination inbox; api/contact.ts falls back to this when RESEND_TO is unset.
CONTACT_TO=hello@ixi.example

# --- Rate limiting ---
# Cloudflare Pages: KV binding name wired in the Pages project settings (functions/api/contact.ts).
# Vercel (root api/contact.ts): KV is not available, so a per-instance in-memory
# fallback is used instead — this key is read by neither on Vercel.
KV_COUNTER=form-rate-limit
CF_PAGES_PROJECT=ixi

# --- App ---
APP_ENV=development
# DEV_STUB must never be '1' in production (contact.ts refuses to start if it is).
DEV_STUB=
