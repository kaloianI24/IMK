---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Thanks — IMK" description="We got your inquiry." path="/thank-you" noindex={true}>
  <section class="container section">
    <h1>Thanks — we got your message.</h1>
    <p style="max-width:60ch;">We reply within 24 hours. If your situation is urgent, send us an email with the details.</p>
    <div style="margin-top:var(--space-6);"><a class="btn btn-primary" href="/contact">Email us</a></div>
  </section>
</BaseLayout
>