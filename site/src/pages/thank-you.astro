---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Thanks — IMK" description="We got your inquiry." path="/thank-you" noindex={true}>
  <section class="container section">
    <h1>Thanks — we got your message.</h1>
    <p style="max-width:60ch;">We reply within 2 business days. If your situation is urgent, book a 15-minute call instead.</p>
    <div style="margin-top:var(--space-6);"><a class="btn btn-primary" href="/book">Book a 15-minute call</a></div>
  </section>
</BaseLayout
>