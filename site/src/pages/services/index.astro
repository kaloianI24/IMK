---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ServiceCard from '../../components/ServiceCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const services = await getCollection('services');
services.sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Services — IMK" description="Workflow automation, B2B AI agents, integration services and automation audits. From £600." path="/services" stickyCta={{ label: "Start an automation audit", href: "/pricing#apply?offer=audit" }}>
  <section class="container section">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />
    <h1>Services</h1>
    <p style="max-width:60ch;">We offer four services. Each ships with a runbook and full ownership transfer. We only take on projects we believe will pay for themselves within a quarter.</p>
    <div class="grid-2" style="margin-top:var(--space-6);">
      {services.map(s => (
        <ServiceCard href={`/services/${s.id}`} title={s.data.title} tagline={s.data.tagline} startingAt={s.data.startingAt} headingLevel="h2" />
      ))}
    </div>
  </section>
</BaseLayout
>