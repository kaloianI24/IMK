---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — IXI" description="We could not find that page." path="/404" noindex={true}>
  <section class="container section">
    <h1>404 — Page not found</h1>
    <p style="max-width:60ch;">The page you want does not exist, or it moved. Head back home, or book a call if you got here while looking for us.</p>
    <div style="margin-top:var(--space-6);display:flex;gap:var(--space-3);">
      <a class="btn btn-secondary" href="/">Go home</a>
      <a class="btn btn-primary" href="/book">Book a call</a>
    </div>
  </section>
</BaseLayout
>