---
interface Props {
  formAction?: string;
}

const { formAction = 'https://formspree.io/f/YOUR_FORM_ID' } = Astro.props;
---

<section class="container section review-form" id="leave-a-review">
  <p class="eyebrow">Leave a review</p>
  <h2>Share your experience</h2>
  <p class="muted">We moderate submissions before publishing them.</p>

  <form
    class="review-form__card"
    action={formAction}
    method="POST"
    novalidate
    id="review-form"
  >
    <div class="review-form__hidden" aria-hidden="true">
      <label for="website">Leave this field empty</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="review-form__grid">
      <div class="review-form__field">
        <label for="name">Name <span aria-label="required">*</span></label>
        <input type="text" id="name" name="name" required autocomplete="name" />
      </div>

      <div class="review-form__field">
        <label for="email">Email (optional)</label>
        <input type="email" id="email" name="email" autocomplete="email" />
      </div>

      <div class="review-form__field">
        <label for="company">Company/Role (optional)</label>
        <input type="text" id="company" name="company" autocomplete="organization" />
      </div>

      <div class="review-form__field">
        <label for="linkedin">Website/LinkedIn (optional)</label>
        <input type="url" id="linkedin" name="linkedin" placeholder="https://example.com" />
      </div>
    </div>

    <div class="review-form__field">
      <span class="review-form__label">Rating <span aria-label="required">*</span></span>
      <div class="star-rating" role="radiogroup" aria-label="Rating">
        <input type="radio" id="rating-5" name="rating" value="5" required />
        <label for="rating-5" aria-label="5 stars">★</label>
        <input type="radio" id="rating-4" name="rating" value="4" />
        <label for="rating-4" aria-label="4 stars">★</label>
        <input type="radio" id="rating-3" name="rating" value="3" />
        <label for="rating-3" aria-label="3 stars">★</label>
        <input type="radio" id="rating-2" name="rating" value="2" />
        <label for="rating-2" aria-label="2 stars">★</label>
        <input type="radio" id="rating-1" name="rating" value="1" />
        <label for="rating-1" aria-label="1 star">★</label>
      </div>
    </div>

    <div class="review-form__field">
      <label for="review">Review <span aria-label="required">*</span></label>
      <textarea id="review" name="review" rows="4" required></textarea>
    </div>

    <div class="review-form__actions">
      <button class="btn btn-primary" type="submit">Submit review</button>
      <p class="review-form__note muted">Your submission will be reviewed before publishing.</p>
    </div>

    <p class="review-form__success" id="review-success" role="status" aria-live="polite" hidden>
      Thanks, your review was submitted. We'll review it before publishing.
    </p>
    <p class="review-form__error" id="review-error" role="alert" hidden>
      Sorry — we couldn't send your review just now. Please try again in a moment.
    </p>
  </form>
</section>

<style>
  .review-form__card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-4);
    background: var(--color-surface);
    margin-top: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .review-form__hidden {
    display: none;
  }

  .review-form__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .review-form__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .review-form__label {
    font-weight: 600;
  }

  .review-form input,
  .review-form textarea {
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 10px 12px;
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
  }

  .review-form input:focus-visible,
  .review-form textarea:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .star-rating {
    display: inline-flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: 4px;
  }

  .star-rating input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .star-rating label {
    font-size: 1.8rem;
    line-height: 1;
    color: color-mix(in srgb, var(--color-text) 30%, transparent);
    cursor: pointer;
    transition: color 120ms ease;
  }

  .star-rating input:checked ~ label,
  .star-rating label:hover,
  .star-rating label:hover ~ label {
    color: var(--color-primary);
  }

  .review-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .review-form__note {
    margin: 0;
  }

  .review-form__success {
    margin: 0;
    color: var(--color-primary);
    font-weight: 600;
  }

  .review-form__error {
    margin: 0;
    color: var(--color-danger, #b00020);
    font-weight: 600;
  }

  :root[data-theme='dark'] .review-form__card {
    background: color-mix(in srgb, var(--color-surface) 92%, white 2%);
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, white 8%);
  }
</style>

<script>
  const form = document.getElementById('review-form');
  const success = document.getElementById('review-success');
  const errorEl = document.getElementById('review-error');

  if (form && success && errorEl) {
    form.addEventListener('submit', async (event) => {
      const formEl = event.target as HTMLFormElement;
      const honeypot = formEl.querySelector('input[name="website"]') as HTMLInputElement | null;

      if (honeypot && honeypot.value) {
        event.preventDefault();
        return;
      }

      if (!formEl.checkValidity()) {
        event.preventDefault();
        formEl.reportValidity();
        return;
      }

      const action = formEl.getAttribute('action');
      if (!action) return;

      event.preventDefault();
      const formData = new FormData(formEl);

      try {
        const response = await fetch(action, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        // Formspree answers 4xx/5xx for rejected submissions; fetch only rejects
        // on network errors, so check the status before claiming success.
        if (!response.ok) {
          throw new Error(`Request failed with status ${response.status}`);
        }

        formEl.reset();
        errorEl.setAttribute('hidden', '');
        success.removeAttribute('hidden');
        success.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (err) {
        success.setAttribute('hidden', '');
        errorEl.removeAttribute('hidden');
        errorEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    });
  }
</script>
