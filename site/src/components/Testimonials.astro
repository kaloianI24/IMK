---
interface Testimonial {
  name: string;
  role?: string;
  company?: string;
  rating?: number;
  quote: string;
}

interface Props {
  items?: Testimonial[];
}

const { items = [] } = Astro.props;
---

<section class="container section testimonials" id="testimonials">
  <p class="eyebrow">What our clients say</p>
  <h2>Testimonials</h2>

  {items.length === 0 ? (
    <p class="testimonials__sample-note">
      Sample content — no approved client quotes yet. Replace this placeholder
      with real testimonials once clients consent to being named.
    </p>
  ) : (
    <div class="testimonials__grid">
      {items.map((item) => (
        <article class="testimonial-card">
          <div class="testimonial-card__stars" aria-label={`${item.rating ?? 5} out of 5 stars`}>
            {Array.from({ length: item.rating ?? 5 }).map(() => (
              <span aria-hidden="true">★</span>
            ))}
          </div>
          <p class="testimonial-card__quote">“{item.quote}”</p>
          <div class="testimonial-card__meta">
            <span class="testimonial-card__name">{item.name}</span>
            {(item.role || item.company) && (
              <span class="testimonial-card__role">
                {[item.role, item.company].filter(Boolean).join(' · ')}
              </span>
            )}
          </div>
        </article>
      ))}
    </div>
  )}
</section>

<style>
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .testimonial-card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-4);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .testimonial-card__stars {
    color: var(--color-primary);
    font-size: 1rem;
    letter-spacing: 2px;
  }

  .testimonial-card__quote {
    margin: 0;
    line-height: 1.7;
  }

  .testimonial-card__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: auto;
  }

  .testimonial-card__name {
    font-weight: 600;
  }

  .testimonial-card__role {
    color: var(--color-text-muted, var(--text-muted));
    font-size: var(--text-sm);
  }

  :root[data-theme='dark'] .testimonial-card {
    background: color-mix(in srgb, var(--color-surface) 92%, white 2%);
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, white 8%);
  }

  .testimonials__sample-note {
    margin: 0;
    color: var(--color-text-muted, var(--text-muted));
    font-size: var(--text-lg);
  }
</style>
