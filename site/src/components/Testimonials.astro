---
interface Testimonial {
  name?: string;
  role?: string;
  company?: string;
  rating?: number;
  quote: string;
  /** Server-derived at publish time: only a verified client carries the badge. */
  verified?: boolean;
  source?: 'portal' | 'public';
}

interface Props {
  items?: Testimonial[];
}

const { items = [] } = Astro.props;
---

<section class="container section testimonials" id="testimonials">
  <p class="eyebrow">What our clients say</p>
  <h2>Testimonials</h2>

  {items.length === 0 ? (
    <p class="testimonials__sample-note">
      Sample content — no approved client quotes yet. Replace this placeholder
      with real testimonials once clients consent to being named.
    </p>
  ) : (
    <div class="testimonials__grid">
      {items.map((item) => (
        <article class="testimonial-card">
          {/* A rating is optional by design: an unrated quote publishes with
              no star row at all — never a fabricated 5★. */}
          {typeof item.rating === 'number' && item.rating >= 1 && (
            <div class="testimonial-card__stars" aria-label={`${item.rating} out of 5 stars`}>
              {Array.from({ length: item.rating }).map(() => (
                <span aria-hidden="true">★</span>
              ))}
            </div>
          )}
          {item.verified && (
            <p class="testimonial-card__badge">
              <span aria-hidden="true">✓</span> Verified client
            </p>
          )}
          <p class="testimonial-card__quote">“{item.quote}”</p>
          {(item.name || item.role || item.company) && (
            <div class="testimonial-card__meta">
              {item.name && <span class="testimonial-card__name">{item.name}</span>}
              {(item.role || item.company) && (
                <span class="testimonial-card__role">
                  {[item.role, item.company].filter(Boolean).join(' · ')}
                </span>
              )}
            </div>
          )}
        </article>
      ))}
    </div>
  )}
</section>

<style>
  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .testimonial-card {
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-4);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .testimonial-card__stars {
    color: var(--color-accent-text);
    font-size: 1rem;
    letter-spacing: 2px;
  }

  .testimonial-card__badge {
    margin: 0;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 2px 10px;
    border: 1px solid color-mix(in srgb, var(--color-accent-text) 35%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-accent-text) 8%, transparent);
    color: var(--color-accent-text);
    font-size: var(--text-xs);
    font-weight: 600;
  }

  .testimonial-card__quote {
    margin: 0;
    line-height: 1.7;
  }

  .testimonial-card__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: auto;
  }

  .testimonial-card__name {
    font-weight: 600;
  }

  .testimonial-card__role {
    color: var(--color-text-muted, var(--text-muted));
    font-size: var(--text-sm);
  }

  :root[data-theme='dark'] .testimonial-card {
    background: color-mix(in srgb, var(--color-surface) 92%, white 2%);
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, white 8%);
  }

  .testimonials__sample-note {
    margin: 0;
    color: var(--color-text-muted, var(--text-muted));
    font-size: var(--text-lg);
  }
</style>
