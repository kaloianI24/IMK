---
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  /**
   * Add `nofollow` to the robots directive.
   *
   * The private screens (spec/07 §7.3, invariant D-4) must not be indexed
   * AND must not pass crawl equity on to the pages they link to. `noindex`
   * alone leaves the links followable, so the owner-only screens opt in.
   * Public pages are unaffected: the default stays `noindex, follow`.
   */
  nofollow?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  stickyCta?: { label: string; href: string } | null;
}
const {
  title,
  description,
  path = '/',
  noindex = false,
  nofollow = false,
  structuredData,
  stickyCta = null,
} = Astro.props;
const siteUrl = (import.meta.env.SITE_URL || 'https://www.imk.example').replace(/\/$/, '');
const canonical = `${siteUrl}${path === '/' ? '/' : path.replace(/\/$/, '')}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content={nofollow ? 'noindex, nofollow' : 'noindex, follow'} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} canonical={canonical} structuredData={structuredData} image={`${siteUrl}/og.png`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {stickyCta && <StickyCta label={stickyCta.label} href={stickyCta.href} />}

    <!-- Mobile Menu Overlay -->
    <div id="imk-menu-overlay" class="imk-menu-overlay">
      <div class="imk-menu-content">
        <nav aria-label="Mobile primary">
          <a href="/">Home</a>
          <a href="/services">Services</a>
          <a href="/work">Work</a>
          <a href="/automations">Tools</a>
          <a href="/process">Process</a>
          <a href="/pricing">Pricing</a>
          <a href="/about">About</a>
          <a href="/login">Log in</a>
          <a href="/contact" class="btn btn-primary" style="margin-top:var(--space-4);width:100%;">Email us</a>
        </nav>
      </div>
    </div>

    <script>
      function setupMenu() {
        const btn = document.getElementById('burger-btn');
        const overlay = document.getElementById('imk-menu-overlay');
        
        if (!btn || !overlay) return;

        btn.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          const isOpen = overlay.classList.toggle('open');
          overlay.style.display = isOpen ? 'flex' : 'none';
          btn.setAttribute('aria-expanded', isOpen);
          document.body.style.overflow = isOpen ? 'hidden' : '';
        };

        overlay.onclick = (e) => {
          if (e.target === overlay) {
            overlay.classList.remove('open');
            overlay.style.display = 'none';
            btn.setAttribute('aria-expanded', 'false');
            document.body.style.overflow = '';
          }
        };
      }

      // Initial setup
      setupMenu();
      // Handle Astro view transitions
      document.addEventListener('astro:after-swap', setupMenu);
      // Fallback for standard loads
      window.addEventListener('load', setupMenu);
      document.addEventListener('DOMContentLoaded', setupMenu);

      // mobile sticky CTA show after scroll out of hero
      const sticky = document.querySelector('[data-sticky-cta]');
      if (sticky) {
        const onScroll = () => { sticky.classList.toggle('open', window.scrollY > 320); };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
