---
import '@fontsource-variable/inter';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  /**
   * Add `nofollow` to the robots directive.
   *
   * The private screens (spec/07 §7.3, invariant D-4) must not be indexed
   * AND must not pass crawl equity on to the pages they link to. `noindex`
   * alone leaves the links followable, so the owner-only screens opt in.
   * Public pages are unaffected: the default stays `noindex, follow`.
   */
  nofollow?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  stickyCta?: { label: string; href: string } | null;
}
const {
  title,
  description,
  path = '/',
  noindex = false,
  nofollow = false,
  structuredData,
  stickyCta = null,
} = Astro.props;
const siteUrl = (import.meta.env.SITE_URL || 'https://www.imk.example').replace(/\/$/, '');
const canonical = `${siteUrl}${path === '/' ? '/' : path.replace(/\/$/, '')}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content={nofollow ? 'noindex, nofollow' : 'noindex, follow'} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Seo title={title} description={description} canonical={canonical} structuredData={structuredData} image={`${siteUrl}/og.png`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {stickyCta && <StickyCta label={stickyCta.label} href={stickyCta.href} />}
    <script>
      const initMenu = () => {
        const burger = document.querySelector('[data-burger]');
        const drawer = document.querySelector('[data-drawer]');
        if (burger && drawer) {
          burger.addEventListener('click', () => {
            const isOpen = drawer.classList.toggle('open');
            burger.setAttribute('aria-expanded', isOpen.toString());
          });
          drawer.addEventListener('click', (e) => {
            if (e.target === drawer) {
              drawer.classList.remove('open');
              burger.setAttribute('aria-expanded', 'false');
            }
          });
        }
      };
      initMenu();
      // mobile sticky CTA show after scroll out of hero
      const sticky = document.querySelector('[data-sticky-cta]');
      if (sticky) {
        const onScroll = () => { sticky.classList.toggle('open', window.scrollY > 320); };
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
