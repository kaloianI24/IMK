# Dependencies
node_modules/

# Build output
dist/
site/dist/
.astro/
site/.astro/

# Lighthouse scratch (qa/artifacts/lighthouse is the kept evidence)
.lighthouseci/
site/.lighthouseci/

# Environment files — never commit real secrets
.env
.env.*
!.env.example

# Portal runtime data — client PII (emails, names, companies), sessions and
# invite records. These are created on first write and must never be committed:
# `git add .` would otherwise sweep live client records into the repo.
# site/data/moderation/ is NOT ignored: the build-time publisher reads it.
site/data/portal/
site/data/snapshot/

# Logs and OS junk
*.log
.DS_Store
Thumbs.db
desktop.ini

# Editor workspace state
.obsidian/workspace*.json

# Wrangler / miniflare state (Cloudflare local dev)
site/.wrangler/

# Vercel CLI project link state (written by "vercel link")
.vercel/

# Scratch dumps — site/jar.txt contains a session cookie (treat as secret)
site/headers.txt
site/jar.txt
